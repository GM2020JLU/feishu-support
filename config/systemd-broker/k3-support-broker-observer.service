[Unit]
Description=K3 support control-side execution evidence observer
After=dbus.service

[Service]
Type=simple
User=k3-support-control
Group=k3-support-control
ExecStart=/opt/k3-support/venv/bin/k3-support-broker-observer --config /etc/k3-support/broker.yaml --watch
StateDirectory=k3-support-control
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
KillMode=control-group
TimeoutStopSec=15
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
